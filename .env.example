# ---------------------------------------------------------------------------
# EduMind environment configuration
# Copy this file to `.env.local` and fill in the values.
# Never commit real secrets. Only variables prefixed with NEXT_PUBLIC_ are
# exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
# Use the anon/public key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias supported for newer Supabase projects that expose a publishable key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: base URL of the deployment, used to build auth redirect links.
# Defaults to the request origin when omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: show the Google sign-in button. Also enable the Google provider in
# Supabase (Authentication -> Providers) and add the /auth/callback URL.
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

# ---------------------------------------------------------------------------
# AI provider (optional)
# EduMind talks to any OpenAI-compatible Chat Completions API over HTTPS.
# When these variables are missing the product shows a clear "AI is not
# configured" state and never fabricates answers.
#
# Examples:
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   OpenRouter:  AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=openai/gpt-4o-mini
#   Groq:        AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   Local:       AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=llama3.1
# ---------------------------------------------------------------------------
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Maximum tokens for a single completion (defaults to 2048)
AI_MAX_OUTPUT_TOKENS=2048
