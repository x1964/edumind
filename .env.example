# ---------------------------------------------------------------------------
# EduMind environment configuration
# Copy this file to `.env.local` and fill in the values.
# Never commit real secrets. Only variables prefixed with NEXT_PUBLIC_ are
# exposed to the browser.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
# Use the anon/public key or the newer publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias supported for newer Supabase projects that expose a publishable key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: base URL of the deployment, used to build auth redirect links.
# Defaults to the request origin when omitted.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth is the only sign-in method. Enable the Google provider in
# Supabase (Authentication -> Providers) and add the /auth/callback URL.
# NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED is no longer read by the app.

# ---------------------------------------------------------------------------
# AI provider (optional)
# EduMind talks to any OpenAI-compatible Chat Completions API over HTTPS.
# When these variables are missing the product shows a clear "AI is not
# configured" state and never fabricates answers.
#
# Examples:
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai
#                  AI_MODEL=gemini-3.6-flash
#   OpenAI:        AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
#   OpenRouter:    AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=openai/gpt-4o-mini
#   Groq:          AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
#   Local:         AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=llama3.1
#
# AI_MODEL_FALLBACKS is a comma-separated list tried when the primary model is
# rate-limited or temporarily unavailable (429 / 5xx).
# ---------------------------------------------------------------------------
AI_PROVIDER=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_MODEL_FALLBACKS=
# Maximum tokens for a single completion (defaults to 2048)
AI_MAX_OUTPUT_TOKENS=2048
# Request timeout in milliseconds (defaults to 90000)
AI_TIMEOUT_MS=90000
# Send `response_format: json_object` to the provider (defaults to false).
# Leave false for Google Gemini's OpenAI-compatible endpoint: it can answer
# structured requests with a misleading 503 when JSON mode is enabled.
AI_JSON_MODE=false

# ---------------------------------------------------------------------------
# Web Push notifications (optional)
# Generate a VAPID pair once with: npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY server-only; only the public key may be NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@edumindapp.vercel.app

# Server-only values used by the hourly Vercel Cron reminder endpoint.
# Never expose or commit the service-role key or cron secret.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# ---------------------------------------------------------------------------
# Distributed rate limiting (required in production)
# Upstash Redis REST credentials. The app fails closed if these are missing in
# production; local development uses an in-process fallback only.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
